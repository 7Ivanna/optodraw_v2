---
// Published figures, redrawn: each card is the saved output of an example cell (scripts/run_examples.py).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cards = [
  { img: '/examples/get-started/01-ligo.svg', title: 'Advanced LIGO', source: 'Abbott et al. 2016, Fig. 3', page: '/get-started/' },
  { img: '/examples/free-space/01-isim.svg', title: 'Structured illumination microscope', source: 'Curd et al. 2015, Fig. 1A', page: '/free-space/' },
  { img: '/examples/chips/01-coupled-rings.svg', title: 'Coupled add-drop rings', source: 'Borghi et al. 2019, Fig. 1', page: '/chips/' },
  { img: '/examples/examples/02-bell.svg', title: 'Bell-test bench', source: 'Lahoz Sanz et al. 2024, Fig. 4', page: '/examples/' },
  { img: '/examples/electronics/01-homodyne-1d.svg', title: 'Homodyne receiver, 1D', source: 'Yang et al. 2025, Fig. 3', page: '/electronics/' },
  { img: '/examples/examples/03-awg.svg', title: 'AWG demultiplexer', source: 'Smit and van Dam 1996', page: '/examples/' },
];
---
<div class="od-gallery">
  {cards.map((c) => (
    <div class="od-card">
      <a class="od-card-img" data-hero-preview data-preview-kind="image" href={base + c.img} aria-label={c.title}><img src={base + c.img} alt={c.title} loading="lazy" /></a>
      <a class="od-card-title" href={base + c.page}>{c.title}</a>
      <span class="od-card-source">{c.source}</span>
    </div>
  ))}
</div>

<style>
  .od-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.4rem 0}
  @media (max-width:50rem){.od-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:32rem){.od-gallery{grid-template-columns:minmax(0,1fr)}}
  .od-card{display:flex;flex-direction:column;gap:.3rem;padding:.6rem;border:1px solid var(--sl-color-gray-5);border-radius:10px;color:inherit;text-decoration:none}
  .od-card:hover{border-color:var(--sl-color-accent)}
  .od-card-img{display:block;aspect-ratio:3/2;background:var(--od-card);border-radius:6px;overflow:hidden}
  .od-card-img img{width:100%;height:100%;object-fit:contain;padding:.4rem;box-sizing:border-box}
  .od-card-title{font-weight:600;font-size:.9rem;color:var(--sl-color-white)}
  .od-card-source{font-size:.8rem;color:var(--sl-color-gray-3)}
</style>
