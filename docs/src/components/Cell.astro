---
// One notebook cell: its title, its code and what it shows. The output is the saved output from CPython
// (scripts/run_examples.py), so the page works with scripts off (rule D8). With scripts on, Run sends the code
// to one Python (Pyodide) for the whole page, and the cells above run first, like a notebook.
import { Code } from '@astrojs/starlight/components';
import cells from '../data/cells.json';

interface Props { id: string; opens?: '1d' | '2d' | '3d' }
const { id, opens } = Astro.props;
const cell = (cells as Record<string, any>)[id];
if (!cell) throw new Error(`no cell ${id}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const output = cell.output ? base + cell.output : null;
const variants = cell.variants as Record<string, string> | undefined;
const modes = variants ? ['1d', '2d', '3d'].filter((mode) => variants[mode]) : [];
const selected = opens ?? (cell.kind === 'html' ? '3d' : '2d');      // the tab the cell opens on
const prefix = 'view-' + id.replace(/[^a-zA-Z0-9-]/g, '-');
const viewNames: Record<string, string> = { '1d': 'Schematic', '2d': 'Layout', '3d': 'Bench / chip' };
---
<figure class="od-cell" data-cell={id} data-browser={String(cell.browser)}>
  <figcaption class="od-cell-title">
    <span>{cell.title}</span>
    {cell.browser ? <span class="od-cell-actions" hidden>
      <button type="button" class="od-run" title="Run this cell (Shift+Enter in the editor)">Run</button>
      <button type="button" class="od-edit">Edit</button>
      <button type="button" class="od-reset" hidden>Reset</button>
    </span> : <span class="od-cell-note">saved output</span>}
  </figcaption>
  <div class="od-cell-code"><Code code={cell.code} lang="python" /></div>
  <textarea class="od-cell-edit" hidden spellcheck="false" aria-label={'Code of ' + cell.title}>{cell.code}</textarea>
  <p class="od-cell-status" hidden aria-live="polite"></p>
  {modes.length > 0 ? <div class="od-views">
    <div class="od-view-bar"><div role="tablist" aria-label="Figure view" class="od-view-tabs">
      {modes.map((mode) => <button type="button" role="tab" id={`${prefix}-${mode}-tab`}
        aria-controls={`${prefix}-${mode}`} aria-selected={mode === selected}
        tabindex={mode === selected ? 0 : -1} data-mode={mode}>
        <span class="od-view-dimension">{mode.toUpperCase()}</span>
        <span class="od-view-name">{viewNames[mode]}</span>
      </button>)}
    </div></div>
    {modes.map((mode) => <div class="od-cell-out" role="tabpanel" id={`${prefix}-${mode}`} data-mode={mode}
      aria-labelledby={`${prefix}-${mode}-tab`} hidden={mode !== selected} tabindex="0">
      {mode === '3d' ? <iframe src={mode === selected ? base + variants![mode] : undefined}
        data-src={base + variants![mode]} title={cell.title + ' in 3D'} loading="lazy" sandbox="allow-scripts"></iframe>
        : <img src={base + variants![mode]} data-saved={base + variants![mode]} alt={cell.title + ' in ' + mode.toUpperCase()} loading="lazy" />}
    </div>)}
  </div> : <div class="od-cell-out">
    {(cell.kind === 'svg' || cell.kind === 'png') && <img src={output} data-saved={output} alt={cell.title} loading="lazy" />}
    {cell.kind === 'html' && <iframe src={output} data-src={output} title={cell.title} loading="lazy" sandbox="allow-scripts"></iframe>}
    {cell.kind === 'text' && <pre class="od-cell-text">{cell.text}</pre>}
  </div>}
  <pre class="od-cell-stdout" hidden={!cell.stdout} data-saved={cell.stdout}>{cell.stdout}</pre>
</figure>

<script>
  import wheel from '../data/wheel.json';

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const live = new WeakMap<HTMLIFrameElement, string>();      // a 3D page the reader's run made
  const blobs = new WeakMap<HTMLImageElement, string>();

  // ---- the figure tabs
  function showFrame(frame: HTMLIFrameElement, active: boolean) {
    if (!active) { frame.removeAttribute('src'); frame.removeAttribute('srcdoc'); return; }
    const html = live.get(frame);
    if (html !== undefined) { frame.removeAttribute('src'); frame.srcdoc = html; }
    else if (!frame.getAttribute('src')) frame.src = frame.dataset.src!;
  }
  function installFigureTabs() {
    document.querySelectorAll<HTMLElement>('.od-views').forEach((viewer) => {
      if (viewer.dataset.ready) return;
      viewer.dataset.ready = 'true';
      const tabs = Array.from(viewer.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      function select(button: HTMLButtonElement) {
        tabs.forEach((tab) => {
          const active = tab === button;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute('aria-controls')!);
          if (!panel) return;
          panel.hidden = !active;
          const frame = panel.querySelector<HTMLIFrameElement>('iframe');
          if (frame) showFrame(frame, active);
        });
      }
      tabs.forEach((button, index) => {
        button.addEventListener('click', () => select(button));
        button.addEventListener('keydown', (event) => {
          const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length
            : event.key === 'ArrowLeft' ? (index + tabs.length - 1) % tabs.length
            : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
          if (next < 0) return;
          event.preventDefault();
          select(tabs[next]);
          tabs[next].focus();
        });
      });
    });
  }

  // ---- one Python for the page
  let worker: Worker | null = null;
  let ready: Promise<void> | null = null;
  let report = (_text: string) => {};
  let next = 0;
  const pending = new Map<number, (result: any) => void>();
  function kernel(): Promise<void> {
    if (ready) return ready;
    worker = new Worker(base + '/pyodide-worker.js', { type: 'module' });
    ready = new Promise((resolve, reject) => {
      worker!.onerror = (event) => reject(new Error(event.message || 'the Python worker did not load'));
      worker!.onmessage = ({ data }) => {
        if (data.type === 'status') report(data.text);
        else if (data.type === 'ready') resolve();
        else if (data.type === 'result' || data.type === 'failed') {
          const result = data.type === 'result' ? data.result : { kind: 'error', data: data.text, stdout: '', views: {} };
          if (data.id === undefined) reject(new Error(data.text));
          else { pending.get(data.id)?.(result); pending.delete(data.id); }
        }
      };
    });
    ready.catch(() => { ready = null; worker?.terminate(); worker = null; });
    worker.postMessage({ type: 'start', wheel: new URL(base + wheel.wheel, location.href).href,
                         display: new URL(base + wheel.display, location.href).href });
    return ready;
  }
  function execute(code: string): Promise<any> {
    const id = next++;
    return new Promise((resolve) => { pending.set(id, resolve); worker!.postMessage({ type: 'run', id, code }); });
  }

  // ---- a cell
  const parts = (cell: HTMLElement) => ({
    edit: cell.querySelector<HTMLTextAreaElement>('.od-cell-edit')!,
    code: cell.querySelector<HTMLElement>('.od-cell-code')!,
    status: cell.querySelector<HTMLElement>('.od-cell-status')!,
    stdout: cell.querySelector<HTMLElement>('.od-cell-stdout')!,
    reset: cell.querySelector<HTMLButtonElement>('.od-reset')!,
  });
  function say(cell: HTMLElement, text: string, error = false) {
    const { status } = parts(cell);
    status.hidden = !text;
    status.textContent = text;
    status.classList.toggle('od-cell-error', error);
  }
  function picture(img: HTMLImageElement, svg: string | null) {
    const old = blobs.get(img);
    if (old) URL.revokeObjectURL(old);
    if (svg === null) { blobs.delete(img); img.src = img.dataset.saved!; return; }
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    blobs.set(img, url);
    img.src = url;
  }
  function show(cell: HTMLElement, result: any) {
    if (result.kind === 'error') return;                    // the status line says what went wrong
    const { stdout } = parts(cell);
    stdout.textContent = result.stdout;
    stdout.hidden = !stdout.textContent;
    const views = result.views || {};
    cell.querySelectorAll<HTMLElement>('.od-cell-out').forEach((panel) => {
      const mode = panel.dataset.mode;
      const img = panel.querySelector<HTMLImageElement>('img');
      const frame = panel.querySelector<HTMLIFrameElement>('iframe');
      const text = panel.querySelector<HTMLElement>('.od-cell-text');
      const svg = mode ? views[mode] : result.kind === 'svg' ? result.data : undefined;
      const html = mode ? views[mode] : result.kind === 'html' ? result.data : undefined;
      if (img && svg) picture(img, svg);
      if (frame && html) { live.set(frame, html); showFrame(frame, !panel.hidden); }
      if (text && result.kind === 'text') text.textContent = result.data;
    });
  }
  function restore(cell: HTMLElement) {
    const { edit, code, stdout, reset } = parts(cell);
    edit.value = edit.defaultValue;
    edit.hidden = true;
    code.hidden = false;
    reset.hidden = true;
    cell.querySelectorAll<HTMLImageElement>('.od-cell-out img').forEach((img) => picture(img, null));
    cell.querySelectorAll<HTMLIFrameElement>('.od-cell-out iframe').forEach((frame) => {
      live.delete(frame);
      showFrame(frame, !frame.closest<HTMLElement>('.od-cell-out')!.hidden);
    });
    stdout.textContent = stdout.dataset.saved || '';
    stdout.hidden = !stdout.textContent;
    say(cell, '');
  }
  async function run(cell: HTMLElement) {
    const all = Array.from(document.querySelectorAll<HTMLElement>('figure.od-cell[data-browser="true"]'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.od-run'));
    buttons.forEach((button) => (button.disabled = true));
    report = (text) => say(cell, text + ' ...');
    try {
      await kernel();
      for (const earlier of all.slice(0, all.indexOf(cell))) {
        if (earlier.dataset.ran) continue;
        say(cell, 'Running the cells above first ...');
        show(earlier, await execute(parts(earlier).edit.value));
        earlier.dataset.ran = 'true';
      }
      say(cell, 'Running ...');
      const started = performance.now();
      const result = await execute(parts(cell).edit.value);
      show(cell, result);
      cell.dataset.ran = 'true';
      parts(cell).reset.hidden = false;
      if (result.kind === 'error') say(cell, (result.data.startsWith('line') ? 'Error on ' : 'Error: ') + result.data, true);
      else say(cell, `Ran in your browser in ${((performance.now() - started) / 1000).toFixed(1)} s.`);
    } catch (error) {
      say(cell, 'Python did not start: ' + (error as Error).message, true);
    } finally {
      buttons.forEach((button) => (button.disabled = false));
    }
  }
  function installCells() {
    document.querySelectorAll<HTMLElement>('figure.od-cell[data-browser="true"]').forEach((cell) => {
      if (cell.dataset.live) return;
      cell.dataset.live = 'true';
      const { edit, code, reset } = parts(cell);
      cell.querySelector<HTMLElement>('.od-cell-actions')!.hidden = false;
      cell.querySelector('.od-run')!.addEventListener('click', () => run(cell));
      cell.querySelector('.od-edit')!.addEventListener('click', () => {
        code.hidden = true;
        edit.hidden = false;
        edit.rows = edit.value.split('\n').length;
        reset.hidden = false;
        edit.focus();
      });
      reset.addEventListener('click', () => restore(cell));
      edit.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && event.shiftKey) { event.preventDefault(); run(cell); }
      });
    });
  }
  function install() { installFigureTabs(); installCells(); }
  install();
  document.addEventListener('astro:page-load', install);
</script>
<style>
  .od-view-bar{display:flex;justify-content:center;margin:0;padding:.65rem 1rem;border-bottom:1px solid var(--sl-color-gray-5);background:var(--od-card)}
  .od-view-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3px;width:min(100%,29rem);margin:0;padding:3px;border:1px solid var(--sl-color-gray-5);border-radius:9px;background:var(--sl-color-gray-6)}
  .od-view-tabs button{appearance:none;display:flex;align-items:center;justify-content:center;gap:.45rem;min-height:40px;margin:0;padding:.4rem .65rem;border:1px solid transparent;border-radius:6px;font:inherit;font-size:.8rem;line-height:1.2;background:transparent;color:var(--sl-color-gray-2);cursor:pointer;white-space:nowrap}
  .od-view-tabs button span{margin:0}
  .od-view-dimension{font-weight:700;font-variant-numeric:tabular-nums}
  .od-view-name{font-size:.75rem}
  .od-view-tabs button:hover{color:var(--sl-color-text);background:var(--sl-color-gray-5)}
  .od-view-tabs button[aria-selected="true"]{background:var(--sl-color-bg);border-color:var(--sl-color-gray-4);color:var(--sl-color-accent-high);box-shadow:0 1px 3px #00000012}
  .od-view-tabs button:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:2px}
  .od-views{margin:0}
  .od-views .od-cell-out{margin:0;border-top:0;height:clamp(18rem,38vw,30rem)}
  .od-views .od-cell-out img,.od-views .od-cell-out iframe{height:100%;max-height:none;margin:0}
  @media(max-width:420px){.od-view-bar{padding:.5rem}.od-view-name{display:none}.od-view-tabs{width:100%}}
  .od-cell-out[hidden]{display:none}
  .od-cell{margin:1.6rem 0;border:1px solid var(--sl-color-gray-5);border-radius:10px;overflow:hidden}
  .od-cell-title{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.45rem .6rem .45rem .9rem;font-size:.85rem;color:var(--sl-color-gray-2);border-bottom:1px solid var(--sl-color-gray-5)}
  .od-cell-note{flex:none;font-size:.75rem;color:var(--sl-color-gray-3)}
  .od-cell-actions{flex:none;display:flex;gap:.35rem}
  .od-cell-actions[hidden],.od-cell-actions button[hidden],.od-cell-code[hidden],.od-cell-edit[hidden],.od-cell-status[hidden],.od-cell-stdout[hidden]{display:none}
  .od-cell-actions button{margin:0;padding:.25rem .75rem;border:1px solid var(--sl-color-gray-4);border-radius:6px;font:inherit;font-size:.78rem;line-height:1.3;background:var(--sl-color-bg);color:var(--sl-color-text);cursor:pointer}
  .od-cell-actions button:hover{border-color:var(--sl-color-accent)}
  .od-cell-actions .od-run{border-color:var(--sl-color-accent);background:var(--sl-color-accent);color:var(--sl-color-text-invert);font-weight:600}
  .od-cell-actions button:disabled{opacity:.55;cursor:progress}
  .od-cell-actions button:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:2px}
  .od-cell :global(.expressive-code){margin:0}
  .od-cell :global(.expressive-code pre){border:0;border-radius:0}
  .od-cell-edit{display:block;box-sizing:border-box;width:100%;margin:0;padding:.9rem 1rem;border:0;border-bottom:1px solid var(--sl-color-gray-5);font-family:var(--__sl-font-mono, monospace);font-size:.8rem;line-height:1.6;color:var(--sl-color-text);background:var(--sl-color-gray-6);resize:vertical;white-space:pre;overflow:auto;tab-size:4}
  .od-cell-edit:focus{outline:2px solid var(--sl-color-accent);outline-offset:-2px}
  .od-cell-status{margin:0;padding:.4rem .9rem;font-size:.78rem;color:var(--sl-color-gray-2);border-top:1px solid var(--sl-color-gray-5)}
  .od-cell-out{background:var(--od-card);border-top:1px solid var(--sl-color-gray-5)}
  .od-cell-out img{display:block;width:100%;height:auto;max-height:28rem;object-fit:contain;padding:.6rem;box-sizing:border-box}
  .od-cell-out iframe{display:block;width:100%;height:24rem;border:0}
  .od-cell-out pre{margin:0;padding:.7rem .9rem;color:#1b1d21;background:transparent;font-size:.8rem;white-space:pre-wrap}
  .od-cell-stdout{margin:0;padding:.7rem .9rem;border-top:1px solid var(--sl-color-gray-5);font-size:.8rem;white-space:pre-wrap}
  .od-cell-error{color:#b42318}
</style>
